        <members>StnryAssetCrbnFtprnt.NZC_Footprints</members>
        <members>StnryAssetEnrgyUse.NZC_Energy_Uses</members>
        <members>VehicleAssetEmssnSrc.NZC_Fleet_Assets</members>
        <members>VehicleAssetCrbnFtprnt.NZC_Fleet_Footprints</members>
        <members>VehicleAssetEnrgyUse.NZC_Fleet_Energy_Uses</members>
        <name>ListView</name>
    </types>
    <version>67.0</version>
</Package>
