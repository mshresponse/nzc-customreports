From 3fe4c81b90a5ddfd01584afcfc7fc4c6ce7f8cc8 Mon Sep 17 00:00:00 2001
From: mshresponse <9147626+mshresponse@users.noreply.github.com>
Date: Mon, 17 Aug 2026 03:45:21 +0000
Subject: [PATCH] Add required titleSize to both dashboards

Deploy against a Net Zero Cloud org rejected both dashboards with "Invalid
title size, must be in the set {8, 9, 10, 12, 14, 18, 24, 36}". The element
was absent entirely rather than wrong. It surfaced only after titleColor was
fixed, since the Metadata API reports one missing required field per component
per attempt.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01PByp6ikfmh71aGqG1zth4k
---
 .../NZC_Dashboards/NZC_Data_Quality.dashboard-meta.xml           | 1 +
 .../NZC_Dashboards/NZC_Emissions_Coverage.dashboard-meta.xml     | 1 +
 2 files changed, 2 insertions(+)

diff --git a/force-app/main/default/dashboards/NZC_Dashboards/NZC_Data_Quality.dashboard-meta.xml b/force-app/main/default/dashboards/NZC_Dashboards/NZC_Data_Quality.dashboard-meta.xml
index ac394d6..0e7c202 100644
--- a/force-app/main/default/dashboards/NZC_Dashboards/NZC_Data_Quality.dashboard-meta.xml
+++ b/force-app/main/default/dashboards/NZC_Dashboards/NZC_Data_Quality.dashboard-meta.xml
@@ -132,4 +132,5 @@
     <textColor>#000000</textColor>
     <title>NZC Data Quality</title>
     <titleColor>#000000</titleColor>
+    <titleSize>18</titleSize>
 </Dashboard>
diff --git a/force-app/main/default/dashboards/NZC_Dashboards/NZC_Emissions_Coverage.dashboard-meta.xml b/force-app/main/default/dashboards/NZC_Dashboards/NZC_Emissions_Coverage.dashboard-meta.xml
index 88b0df5..5493c1a 100644
--- a/force-app/main/default/dashboards/NZC_Dashboards/NZC_Emissions_Coverage.dashboard-meta.xml
+++ b/force-app/main/default/dashboards/NZC_Dashboards/NZC_Emissions_Coverage.dashboard-meta.xml
@@ -75,4 +75,5 @@
     <textColor>#000000</textColor>
     <title>NZC Emissions Coverage</title>
     <titleColor>#000000</titleColor>
+    <titleSize>18</titleSize>
 </Dashboard>
-- 
