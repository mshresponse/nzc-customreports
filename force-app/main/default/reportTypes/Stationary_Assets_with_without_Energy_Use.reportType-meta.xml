<?xml version="1.0" encoding="UTF-8"?>
<ReportType xmlns="http://soap.sforce.com/2006/04/metadata">
    <baseObject>StnryAssetEnvrSrc</baseObject>
    <category>other</category>
    <deployed>true</deployed>
    <description>Stationary Asset Environmental Sources with or without related Stationary Asset Energy Use records (outer join). Use this report type to find assets with no consumption data recorded at all, which is an earlier gap than a missing footprint.</description>
    <join>
        <outerJoin>true</outerJoin>
        <!-- Relationship name read from a describe against a Net Zero Cloud org, not
             inferred: StnryAssetEnvrSrc exposes its StnryAssetEnrgyUse children as
             StationaryAssetEnergyUses. -->
        <relationship>StationaryAssetEnergyUses</relationship>
    </join>
    <label>Stationary Assets with/without Energy Use</label>
    <sections>
