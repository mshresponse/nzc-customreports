<?xml version="1.0" encoding="UTF-8"?>
<ReportType xmlns="http://soap.sforce.com/2006/04/metadata">
    <baseObject>Account</baseObject>
    <category>other</category>
    <deployed>true</deployed>
    <description>Accounts with or without related Supplier records (outer join). Use this report type to find value-chain accounts that have not yet been registered as suppliers, which is the first gap to close before Scope 3 supplier data can be collected.</description>
    <join>
        <outerJoin>true</outerJoin>
        <!-- VERIFY IN ORG: Salesforce does not publish child relationship names in the
             object reference, so this is the conventional plural rather than a
             documented value. If the deploy fails here, read the real name from a
             describe (see README > Verifying relationship names) and replace it both
             on this line and in the <table> paths below. -->
        <relationship>Suppliers</relationship>
    </join>
    <label>Accounts with or without Suppliers</label>
    <sections>
        <columns>
            <checkedByDefault>true</checkedByDefault>
            <field>Name</field>
            <table>Account</table>
        </columns>
        <columns>
            <checkedByDefault>true</checkedByDefault>
            <field>Industry</field>
            <table>Account</table>
        </columns>
        <columns>
            <checkedByDefault>true</checkedByDefault>
            <field>BillingCountry</field>
            <table>Account</table>
        </columns>
        <masterLabel>Accounts</masterLabel>
    </sections>
    <sections>
        <columns>
            <checkedByDefault>true</checkedByDefault>
            <field>Name</field>
            <table>Account.Suppliers</table>
        </columns>
        <columns>
            <checkedByDefault>true</checkedByDefault>
            <field>CompanyRelationshipType</field>
            <table>Account.Suppliers</table>
        </columns>
        <columns>
            <checkedByDefault>true</checkedByDefault>
            <field>Description</field>
            <table>Account.Suppliers</table>
        </columns>
        <masterLabel>Suppliers</masterLabel>
    </sections>
</ReportType>
